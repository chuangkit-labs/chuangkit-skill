{
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "env": {
    "CHUANGKIT_CLI_AUTH_MODE": "server",
    "CHUANGKIT_CLI_CONFIG_DIR": "$HOME/.workbuddy/connectors/skills/connector-chuangkit/config"
  },
  "init": {
    "darwin": "npm install --global @chuangkit-labs/agent-cli@0.1.1",
    "linux": "npm install --global @chuangkit-labs/agent-cli@0.1.1",
    "win32": "npm install --global @chuangkit-labs/agent-cli@0.1.1"
  },
  "auth": {
    "darwin": "ckt-agent auth login",
    "linux": "ckt-agent auth login",
    "win32": "ckt-agent.exe auth login"
  },
  "unAuth": {
    "darwin": "ckt-agent auth logout",
    "linux": "ckt-agent auth logout",
    "win32": "ckt-agent.exe auth logout"
  },
  "status": {
    "darwin": "ckt-agent auth status",
    "linux": "ckt-agent auth status",
    "win32": "ckt-agent.exe auth status"
  },
  "statusMatch": "Authenticated"
}
